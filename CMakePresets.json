{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "DOMINO_ENABLE_NATIVE_ARCH": "OFF",
        "DOMINO_PLAYGROUND_MODE": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "调试"
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "发布（可移植）",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-native",
      "inherits": "release",
      "displayName": "发布（-march=native，产物仅限本机或同架构 CPU）",
      "cacheVariables": {
        "DOMINO_ENABLE_NATIVE_ARCH": "ON"
      }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "displayName": "ASan + UBSan + LSan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined,leak -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,leak",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined,leak"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "profile",
      "inherits": "base",
      "displayName": "gprof 性能分析",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-pg -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-pg",
        "CMAKE_SHARED_LINKER_FLAGS": "-pg"
      }
    }
  ]
}
