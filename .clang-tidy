# Clang-Tidy代码分析配置文件
# 与 CODING_STANDARDS.md 保持一致

Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  modernize-*,
  cert-*,
  misc-*,
  clang-analyzer-*,

# 代码风格检查（与规范文档一致）
# 注意：CheckOptions 使用 YAML 格式，每个检查项用点号分隔
CheckOptions: 
  readability-function-cognitive-complexity.Threshold: 50

FormatStyle: 'file'



