{
  // VSCode 本地及远程开发配置
  "files.associations": {
    "*.h": "c"
  },
  // 禁用Microsoft C/C++扩展的IntelliSense（使用clangd替代）
  "C_Cpp.intelliSenseEngine": "Disabled",
  // clangd配置（替代Microsoft C/C++扩展的智能提示）
  "clangd.path": "${workspaceFolder}/scripts/clangd.sh",
  "clangd.useScriptAsExecutable": true,
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--function-arg-placeholders=false",
    "--query-driver=/usr/bin/clang,/usr/bin/clang-*"
  ],
  "clangd.fallbackFlags": [
    "-std=c23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wformat-security",
    "-Wnull-dereference",
    "-Wuninitialized",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wunused",
    "-Wformat=2"
  ],
  // C 文件通过 clangd 内置的 clang-format 读取项目 .clang-format 配置。
  "editor.formatOnSave": true,
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  // 文件编码
  "files.encoding": "utf8",
  "files.eol": "\n",
  // 过滤文件
  "files.watcherExclude": {
    "**/build-*/**": true
  },
  "search.exclude": {
    "**/build-*/**": true
  }
}